#!/usr/bin/env bash
# Ouvre une fenêtre de ~/.config/quickshell/outils, ou la ferme si elle est déjà ouverte.
# Usage : qs-outil <inactivite|capture|raccourcis|presse-papiers|emojis|projets|fenetres|ports>

set -euo pipefail

readonly name=${1:?usage : qs-outil <inactivite|capture|raccourcis|presse-papiers|emojis|projets|fenetres|ports>}
readonly file=$HOME/.config/quickshell/outils/$name.qml

if [[ ! -f $file ]]; then
  printf 'qs-outil : fenêtre inconnue : %s\n' "$name" >&2
  exit 64
fi

qs kill -p "$file" >/dev/null 2>&1 || exec qs -p "$file" -n -d
